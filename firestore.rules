rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incomingData() {
      return request.resource.data;
    }

    function existingData() {
      return resource.data;
    }

    // 0. Eng kam imtiyoz tamoyili
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) 
                    && incomingData().keys().hasAny(['email', 'displayName', 'uid']);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. UserProgress
    match /userProgress/{progressId} {
      allow read: if isAuthenticated() && existingData().userId == request.auth.uid;
      allow create: if isAuthenticated() 
                    && incomingData().userId == request.auth.uid
                    && incomingData().keys().hasAll(['userId', 'lessonId', 'completed']);
      allow update: if isAuthenticated() 
                    && existingData().userId == request.auth.uid
                    && incomingData().userId == request.auth.uid;
      allow delete: if false;
    }

    // 3. QuizResults
    match /quizResults/{resultId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
                    && incomingData().userId == request.auth.uid
                    && incomingData().score >= 0 
                    && incomingData().score <= 100;
      allow update, delete: if false;
    }

    // 4. Chats
    match /chats/{chatId} {
       allow read, delete: if isAuthenticated() && existingData().userId == request.auth.uid;
       allow create, update: if isAuthenticated() && incomingData().userId == request.auth.uid;
    }
    
    // 5. userQuestionStates
    match /userQuestionStates/{stateId} {
       allow read: if isAuthenticated() && existingData().userId == request.auth.uid;
       allow create: if isAuthenticated() && incomingData().userId == request.auth.uid;
       allow update: if isAuthenticated() 
                     && existingData().userId == request.auth.uid 
                     && incomingData().userId == request.auth.uid;
       allow delete: if false;
    }

    // 6. Sections (darslar) va uning ichki qismlari (chapters, topics)
    // Bu asosiy struktura, shuning uchun barcha avtorizatsiyadan o'tganlarga o'qish erkin
    match /sections/{document=**} {
       allow read: if isAuthenticated();
       allow write: if false; // Faqat backend (admin) tomonidan yangilanadi
    }

    // 7. Lessons
    match /lessons/{lessonId} {
       allow read: if isAuthenticated();
       allow write: if false;
    }

    // 8. Drawings (canvas)
    match /drawings/{drawingId} {
       allow read: if isAuthenticated() && existingData().userId == request.auth.uid;
       allow create: if isAuthenticated() && incomingData().userId == request.auth.uid;
       allow update: if isAuthenticated() 
                     && existingData().userId == request.auth.uid 
                     && incomingData().userId == request.auth.uid;
       allow delete: if isAuthenticated() && existingData().userId == request.auth.uid;
    }
  }
}